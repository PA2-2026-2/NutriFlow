generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  phone           String?
  profile         String
  passwordHash    String
  isActive        Boolean         @default(true)
  profilePhotoUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  patientProfile  PatientProfile?

  patients PatientProfile[] @relation("NutritionistPatients")
  mealPlansAsPatient MealPlan[] @relation("PatientMealPlans")
  mealPlansAsNutritionist MealPlan[] @relation("NutritionistMealPlans")
}

model PatientProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  age          Int?
  weight       Float?
  height       Float?
  objective    String?
  restrictions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  nutritionistId String?
  nutritionist   User?   @relation("NutritionistPatients", fields: [nutritionistId], references: [id])

  measurements PatientMeasurement[]
}

model PatientMeasurement {
  id                         String         @id @default(uuid())
  patientProfileId           String
  weightKg                   Float
  heightCm                   Float
  bodyFatPercent             Float?
  notes                      String?
  neckCircumferenceCm        Float?
  chestCircumferenceCm       Float?
  waistCircumferenceCm       Float?
  hipCircumferenceCm         Float?
  armCircumferenceCm         Float?
  thighCircumferenceCm       Float?
  calfCircumferenceCm        Float?
  tricepsSkinfoldMm          Float?
  bicepsSkinfoldMm           Float?
  subscapularSkinfoldMm      Float?
  suprailiacSkinfoldMm       Float?
  abdominalSkinfoldMm        Float?
  thighSkinfoldMm            Float?
  calfSkinfoldMm             Float?
  recordedAt                 DateTime       @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId, recordedAt])
}

model Food {
  id        String   @id
  name      String   @unique
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())

  mealPlanItems MealPlanItem[]
}

model MealPlan {
  id             String         @id @default(uuid())
  patientId      String
  nutritionistId String
  title          String
  notes          String?
  calories       Float          @default(0)
  protein        Float          @default(0)
  carbs          Float          @default(0)
  fats           Float          @default(0)
  startDate      DateTime       @default(now())
  endDate        DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User           @relation("PatientMealPlans", fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist User           @relation("NutritionistMealPlans", fields: [nutritionistId], references: [id], onDelete: Cascade)
  items        MealPlanItem[]

  @@index([patientId, createdAt])
  @@index([nutritionistId, createdAt])
}

model MealPlanItem {
  id         String   @id @default(uuid())
  mealPlanId String
  foodId     String
  quantity   Float
  mealTime   String

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  food     Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealPlanId])
}
