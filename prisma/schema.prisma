generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

model User {
  id              String          @id @default(uuid())
  authUserId      String?         @unique
  name            String
  email           String          @unique
  phone           String?
  profile         String
  passwordHash    String
  isActive        Boolean         @default(true)
  profilePhotoUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  patientProfile  PatientProfile?

  patients PatientProfile[] @relation("NutritionistPatients")
  mealPlansAsPatient MealPlan[] @relation("PatientMealPlans")
  mealPlansAsNutritionist MealPlan[] @relation("NutritionistMealPlans")
  challengesAsNutritionist Challenge[] @relation("NutritionistChallenges")
  challengeParticipants ChallengeParticipant[] @relation("PatientChallengeParticipants")
  mealEntries PatientMealEntry[]
  weightEntries PatientWeightEntry[]
  sentMessages ChatMessage[] @relation("ChatMessageSender")
  receivedMessages ChatMessage[] @relation("ChatMessageRecipient")
  appointmentsAsPatient Appointment[] @relation("AppointmentPatient")
  appointmentsAsNutritionist Appointment[] @relation("AppointmentNutritionist")
}

model PatientProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  age          Int?
  weight       Float?
  height       Float?
  objective    String?
  restrictions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  nutritionistId String?
  nutritionist   User?   @relation("NutritionistPatients", fields: [nutritionistId], references: [id])

  measurements PatientMeasurement[]
}

model PatientMeasurement {
  id                         String         @id @default(uuid())
  patientProfileId           String
  weightKg                   Float
  heightCm                   Float
  bodyFatPercent             Float?
  notes                      String?
  neckCircumferenceCm        Float?
  chestCircumferenceCm       Float?
  waistCircumferenceCm       Float?
  hipCircumferenceCm         Float?
  armCircumferenceCm         Float?
  thighCircumferenceCm       Float?
  calfCircumferenceCm        Float?
  tricepsSkinfoldMm          Float?
  bicepsSkinfoldMm           Float?
  subscapularSkinfoldMm      Float?
  suprailiacSkinfoldMm       Float?
  abdominalSkinfoldMm        Float?
  thighSkinfoldMm            Float?
  calfSkinfoldMm             Float?
  recordedAt                 DateTime       @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId, recordedAt])
}

model Food {
  id          String   @id
  name        String   @unique
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  mealPlanItems MealPlanItem[]
}

model MealPlan {
  id             String         @id @default(uuid())
  patientId      String
  nutritionistId String
  title          String
  notes          String?
  calories       Float          @default(0)
  protein        Float          @default(0)
  carbs          Float          @default(0)
  fats           Float          @default(0)
  startDate      DateTime       @default(now())
  endDate        DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User           @relation("PatientMealPlans", fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist User           @relation("NutritionistMealPlans", fields: [nutritionistId], references: [id], onDelete: Cascade)
  items        MealPlanItem[]

  @@index([patientId, createdAt])
  @@index([nutritionistId, createdAt])
}

model MealPlanItem {
  id         String   @id @default(uuid())
  mealPlanId String
  foodId     String
  quantity   Float
  mealTime   String

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  food     Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealPlanId])
}

model PatientMealEntry {
  id          String   @id @default(uuid())
  userId      String
  mealType    String
  title       String
  description String   @default("")
  calories    Int
  protein     Int
  carbs       Int
  fats        Int
  fiber       Int
  waterMl     Int
  loggedAt    DateTime
  createdAt   DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model PatientWeightEntry {
  id        String   @id @default(uuid())
  userId    String
  weightKg  Float
  recordedAt DateTime
  note      String   @default("")
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model Challenge {
  id             String   @id @default(uuid())
  nutritionistId String
  title          String
  description    String?
  category       String?
  goalDescription String
  goalTarget     Float?
  startDate      DateTime
  endDate        DateTime
  status         String   @default("AGENDADO")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nutritionist User @relation("NutritionistChallenges", fields: [nutritionistId], references: [id], onDelete: Restrict)
  participants ChallengeParticipant[]

  @@index([nutritionistId, createdAt])
  @@index([startDate, endDate])
}

model ChallengeParticipant {
  id         String   @id @default(uuid())
  challengeId String
  patientId   String
  enrolledAt  DateTime @default(now())
  status      String   @default("INSCRITO")
  progress    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  patient   User @relation("PatientChallengeParticipants", fields: [patientId], references: [id], onDelete: Restrict)
  checkIns  ChallengeCheckIn[]

  @@unique([challengeId, patientId])
  @@unique([id, patientId])
}

model ChallengeCheckIn {
  id            String   @id @default(uuid())
  participationId String
  patientId       String
  checkInDate     DateTime @db.Date
  completed       Boolean  @default(false)
  recordedValue   Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation ChallengeParticipant @relation(fields: [participationId, patientId], references: [id, patientId], onDelete: Restrict)

  @@unique([participationId, checkInDate])
  @@index([patientId, checkInDate])
}

model ChatMessage {
  id                  String   @id @default(uuid())
  senderId            String
  recipientId         String
  content             String
  type                String   @default("TEXT")
  audioData           String?
  audioMimeType       String?
  audioDurationSeconds Int?
  transcript          String?
  status              String   @default("UNREAD")
  createdAt            DateTime @default(now())
  readAt               DateTime?

  sender    User @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, status, createdAt])
}

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  nutritionistId String
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(AGENDADA)
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient      User @relation("AppointmentPatient", fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist User @relation("AppointmentNutritionist", fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([patientId, startAt])
  @@index([nutritionistId, startAt])
}
