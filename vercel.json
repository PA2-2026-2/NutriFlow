{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "{frontend/**,node_modules/@supabase/supabase-js/dist/umd/supabase.js}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
