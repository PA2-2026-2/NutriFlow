{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "frontend/**",
        "node_modules/@supabase/supabase-js/dist/umd/supabase.js"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
